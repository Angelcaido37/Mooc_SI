rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
  function signedIn(){ return request.auth != null; }
  function owner(uid){ return signedIn() && request.auth.uid == uid; }
  function teacher(){ return signedIn() && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'teacher'; }
  match /roles/{uid} { allow read: if owner(uid); allow write: if false; }
  match /users/{uid} { allow read,create,update: if owner(uid) || teacher(); allow delete: if owner(uid);
    match /exitTickets/{id} { allow create,read,update: if owner(uid) || teacher(); allow delete: if owner(uid); }
    match /evidence/{id} { allow create,read,update: if owner(uid) || teacher(); allow delete: if owner(uid); }
  }
  match /progress/{uid} { allow create,read,update: if owner(uid) || teacher(); allow delete: if owner(uid); }
  match /leaderboard/{uid} {
    allow read: if signedIn();
    allow delete: if owner(uid);
    allow create,update: if owner(uid)
      && request.resource.data.keys().hasOnly(['alias','team','avatar','level','weeklyKey','weeklyLessons','weeklyBonuses','weeklyScore','goalMet','updatedAt'])
      && request.resource.data.alias is string
      && request.resource.data.alias.size() >= 3
      && request.resource.data.alias.size() <= 24
      && request.resource.data.team in ['orion','quantum','nebula','atlas']
      && request.resource.data.weeklyLessons >= 0
      && request.resource.data.weeklyLessons <= 30
      && request.resource.data.weeklyBonuses >= 0
      && request.resource.data.weeklyBonuses <= 4
      && request.resource.data.weeklyScore >= 0
      && request.resource.data.weeklyScore <= 360;
  }
  match /teacherUsage/{uid} { allow read,create,update: if owner(uid) && teacher(); allow delete: if false; }
  match /teacherReflections/{uid}/entries/{id} { allow read,create: if owner(uid) && teacher(); allow update,delete: if false; }
  match /teacherSessionLogs/{uid}/sessions/{sessionId} { allow read,create,update: if owner(uid) && teacher(); allow delete: if false; }
  match /coursework/{id} { allow read: if signedIn(); allow write: if teacher(); }
  match /classroomTokens/{uid} { allow read,write: if false; }
  match /oauthStates/{id} { allow read,write: if false; }
} }
